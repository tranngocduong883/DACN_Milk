{
  "info": {
    "name": "NutriMilk API Tests",
    "description": "Kiểm thử tự động API NutriMilk. Chạy bằng Postman (Run collection) hoặc Newman.\nCần chạy backend trước và đặt biến baseUrl (mặc định http://localhost:5014).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5014"
    }
  ],
  "item": [
    {
      "name": "1. Xác thực",
      "item": [
        {
          "name": "Đăng nhập sai mật khẩu",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 400', () => pm.response.to.have.status(400));",
                  "pm.test('success = false', () => pm.expect(pm.response.json().success).to.be.false);",
                  "pm.test('Báo sai tài khoản hoặc mật khẩu', () => pm.expect(pm.response.json().message).to.eql('Tên đăng nhập hoặc mật khẩu không chính xác'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Authentication/Login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Authentication",
                "Login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenDangNhap\": \"khong_ton_tai\",\n  \"matKhau\": \"sai123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đăng ký - mật khẩu 5 ký tự (dưới biên)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 400', () => pm.response.to.have.status(400));",
                  "pm.test('Báo lỗi độ dài mật khẩu', () => pm.expect(pm.response.json().message).to.eql('Mật khẩu phải có ít nhất 6 ký tự'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Authentication/Register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Authentication",
                "Register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenDangNhap\": \"autotest_bien\",\n  \"matKhau\": \"12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đăng ký - email sai định dạng",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 400', () => pm.response.to.have.status(400));",
                  "pm.test('Báo lỗi email', () => pm.expect(pm.response.json().message).to.eql('Email không hợp lệ'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Authentication/Register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Authentication",
                "Register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenDangNhap\": \"autotest_email\",\n  \"matKhau\": \"123456\",\n  \"email\": \"abc@\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đăng ký thành công - mật khẩu 6 ký tự (đúng biên)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tên đăng nhập và email ngẫu nhiên để mỗi lần chạy đều tạo được tài khoản mới",
                  "const id = Date.now();",
                  "pm.collectionVariables.set('username', 'autotest_' + id);",
                  "pm.collectionVariables.set('email', 'autotest_' + id + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 200', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Authentication/Register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Authentication",
                "Register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenDangNhap\": \"{{username}}\",\n  \"matKhau\": \"123456\",\n  \"email\": \"{{email}}\",\n  \"hoTen\": \"Auto Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đăng ký trùng tên đăng nhập",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 400', () => pm.response.to.have.status(400));",
                  "pm.test('Báo trùng tên đăng nhập', () => pm.expect(pm.response.json().message).to.eql('Tên đăng nhập đã tồn tại'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Authentication/Register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Authentication",
                "Register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenDangNhap\": \"{{username}}\",\n  \"matKhau\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đăng ký trùng email (BUG-01)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('username2', 'autotest_' + Date.now() + '_b');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 400', () => pm.response.to.have.status(400));",
                  "pm.test('Báo trùng email', () => pm.expect(pm.response.json().message).to.eql('Email đã được sử dụng'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Authentication/Register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Authentication",
                "Register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenDangNhap\": \"{{username2}}\",\n  \"matKhau\": \"123456\",\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đăng nhập thành công",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 200', () => pm.response.to.have.status(200));",
                  "const login = pm.response.json().data;",
                  "pm.test('Có token và vai trò là user', () => {",
                  "  pm.expect(login.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(login.vaiTro).to.eql('user');",
                  "});",
                  "// Lưu token cho các request phân quyền phía sau",
                  "pm.collectionVariables.set('userToken', login.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Authentication/Login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Authentication",
                "Login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenDangNhap\": \"{{username}}\",\n  \"matKhau\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Sản phẩm",
      "item": [
        {
          "name": "Lấy danh sách sản phẩm",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 200', () => pm.response.to.have.status(200));",
                  "pm.test('data là mảng', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('Phản hồi dưới 2 giây', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/SanPham",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "SanPham"
              ]
            }
          }
        },
        {
          "name": "Phân trang - 3 sản phẩm mỗi trang",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('Không quá 3 sản phẩm', () => pm.expect(d.items.length).to.be.at.most(3));",
                  "pm.test('totalPages tính đúng', () => pm.expect(d.totalPages).to.eql(Math.ceil(d.totalItems / 3)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/SanPham/search?page=1&pageSize=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "SanPham",
                "search"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "Phân trang - pageSize = 100 (đúng biên trên)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/SanPham/search?pageSize=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "SanPham",
                "search"
              ],
              "query": [
                {
                  "key": "pageSize",
                  "value": "100"
                }
              ]
            }
          }
        },
        {
          "name": "Phân trang - pageSize = 101 (vượt biên)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 400', () => pm.response.to.have.status(400));",
                  "pm.test('Báo lỗi pageSize', () => pm.expect(pm.response.json().message).to.eql('Số sản phẩm mỗi trang phải từ 1 đến 100'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/SanPham/search?pageSize=101",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "SanPham",
                "search"
              ],
              "query": [
                {
                  "key": "pageSize",
                  "value": "101"
                }
              ]
            }
          }
        },
        {
          "name": "Sắp xếp giá tăng dần",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 200', () => pm.response.to.have.status(200));",
                  "const prices = pm.response.json().data.items.map(p => p.gia);",
                  "pm.test('Giá tăng dần', () => pm.expect(prices).to.eql([...prices].sort((a, b) => a - b)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/SanPham/search?sapXep=gia_asc&pageSize=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "SanPham",
                "search"
              ],
              "query": [
                {
                  "key": "sapXep",
                  "value": "gia_asc"
                },
                {
                  "key": "pageSize",
                  "value": "100"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Phân quyền",
      "item": [
        {
          "name": "Thêm danh mục khi chưa đăng nhập",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/DanhMuc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "DanhMuc"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maDanhMuc\": \"DM_TEST\",\n  \"tenDanhMuc\": \"Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Thêm danh mục bằng tài khoản user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Trả về 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/DanhMuc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "DanhMuc"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maDanhMuc\": \"DM_TEST\",\n  \"tenDanhMuc\": \"Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
